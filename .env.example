# Copy this file to .env and fill in your values.

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rescuer_locator
POSTGRES_USER=rescuer
POSTGRES_PASSWORD=change_me

# ── Backend ───────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_long_random_string
REFRESH_TOKEN_EXPIRE_DAYS=7
LOCATION_RETENTION_DAYS=90  # background task deletes location_events older than this many days
# Password of the `admin` account created on an empty database. Empty = `admin` (change it at first
# login). Set it before the first start on anything reachable by more than this laptop.
INITIAL_ADMIN_PASSWORD=

# ── Weather overlay (OpenWeatherMap) ─────────────────────────
# Get a free key at https://openweathermap.org/api. Read by the backend only (routers/weather.py
# proxies OWM), so it never reaches the browser. The old name VITE_OWM_API_KEY still works.
OWM_API_KEY=

# ── Serial reader ─────────────────────────────────────────────
# On macOS run `ls /dev/cu.*` to find the port name
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=9600

# ── HID reader ────────────────────────────────────────────────
# USB HID gateway VID and PID (hexadecimal)
HID_VENDOR_ID=0x0ACD
HID_PRODUCT_ID=0xFAAF

# ── Offline maps ──────────────────────────────────────────────
# Asked before the BG Mountains tile download starts (Settings → Offline maps). Empty or change_me logs a warning.
OFFLINE_MAPS_PASSWORD=

# ── Backups ───────────────────────────────────────────────────
# Where scripts/backup.sh writes dumps (default ./backups). Point at a USB stick.
# BACKUP_DIR=

# ── Safety ────────────────────────────────────────────────────
# Enables Settings → Test mode and POST /api/test/simulate, which write FABRICATED positions.
# Never true in the field.
ENABLE_TEST_ENDPOINTS=false
# Devices with no fix newer than this drop off the live map (ghosts from past operations).
LIVE_POSITION_MAX_AGE_HOURS=24
# Access token lifetime; the browser refreshes silently, so this can stay short.
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Who may log in. Admin-only is the rule; rescuers and viewers keep their accounts but cannot sign in.
# (The setting accepts a comma-separated list of admin, rescuer, viewer.)
LOGIN_ROLES=admin

# ── Migrations ────────────────────────────────────────────────
# Pending migrations run only after a fresh backup (start.sh/start.ps1 take one first). Development
# data only: true migrates without it and logs a WARNING.
ALLOW_MIGRATE_WITHOUT_BACKUP=false
# A migration that cannot get its table locks within this time fails start-up instead of waiting.
MIGRATION_LOCK_TIMEOUT=5s
